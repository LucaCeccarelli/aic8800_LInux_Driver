# Shell scripts, services and config MUST use LF or they break on Linux.
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.desktop   text eol=lf
*.conf      text eol=lf
*.spec      text eol=lf
aic-wifi-mode text eol=lf

# Driver sources keep LF.
*.c text eol=lf
*.h text eol=lf

# Firmware and other binaries.
*.bin binary
